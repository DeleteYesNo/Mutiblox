<UserControl x:Class="Mutiblox.Views.Pages.AccountListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#CDD6F4" Padding="16">
    <DockPanel>
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="帳號管理" FontSize="24" FontWeight="Bold" Margin="0,0,0,12" />

            <!-- Quick Login Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="瀏覽器登入" Margin="0,0,8,0"
                        Command="{Binding BrowserLoginCommand}"
                        Style="{StaticResource PrimaryButton}" />

                <Button Content="從瀏覽器匯入" Margin="0,0,8,0"
                        Command="{Binding ImportFromBrowserCommand}"
                        Style="{StaticResource PrimaryButton}" />

                <Button Content="驗證全部" Margin="0,0,0,0"
                        Command="{Binding VerifyAllCommand}"
                        Style="{StaticResource SecondaryButton}" />
            </StackPanel>

            <!-- Manual Cookie Input -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="CookieInput" Grid.Column="0"
                         Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"
                         Padding="8,6" FontSize="13" VerticalContentAlignment="Center" />

                <Button Grid.Column="1" Content="手動新增" Margin="8,0,0,0"
                        Command="{Binding AddAccountCommand}"
                        CommandParameter="{Binding Text, ElementName=CookieInput}"
                        Style="{StaticResource SecondaryButton}" />
            </Grid>
        </StackPanel>

        <!-- Status Bar -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                   Foreground="#A6ADC8" Margin="0,8,0,0" FontSize="12"
                   TextWrapping="Wrap" />

        <!-- Loading -->
        <ProgressBar DockPanel.Dock="Bottom" IsIndeterminate="{Binding IsLoading}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                     Height="2" Background="Transparent" Foreground="#89B4FA" Margin="0,8,0,0" />

        <!-- Account List -->
        <ListView ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                  Background="Transparent" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="8" Padding="12" Margin="0,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#313244" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCookieExpired}" Value="True">
                                        <Setter Property="Background" Value="#3E2030" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Account Info -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="#CDD6F4" />

                                    <!-- Status Badge -->
                                    <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#45475A" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCookieExpired}" Value="True">
                                                        <Setter Property="Background" Value="#F38BA8" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                                        <Setter Property="Background" Value="#1E4620" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="10"
                                                   Foreground="#CDD6F4" />
                                    </Border>
                                </StackPanel>

                                <TextBlock FontSize="12" Foreground="#A6ADC8" Margin="0,4,0,0">
                                    <Run Text="User ID: " />
                                    <Run Text="{Binding UserId, Mode=OneWay}" />
                                    <Run Text=" | " />
                                    <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <!-- Re-login button (only visible when expired) -->
                            <Button Grid.Column="1" Content="重新登入" Margin="4,0"
                                    Command="{Binding DataContext.ReLoginAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCookieExpired}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Action buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="驗證" Margin="4,0"
                                        Command="{Binding DataContext.VerifyAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SecondaryButton}" />
                                <Button Content="移除" Margin="4,0"
                                        Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource DangerButton}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </DockPanel>
</UserControl>
