<UserControl x:Class="Mutiblox.Views.Pages.InstanceDashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#CDD6F4" Padding="16">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="實例監控" FontSize="24" FontWeight="Bold" Margin="0,0,0,12" />

            <!-- Summary -->
            <Border Background="#313244" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="14" Margin="0,0,24,0">
                        <Run Text="執行中: " />
                        <Run Text="{Binding RunningCount, Mode=OneWay}" Foreground="#A6E3A1" FontWeight="Bold" />
                    </TextBlock>
                    <TextBlock FontSize="14">
                        <Run Text="總記憶體: " />
                        <Run Text="{Binding TotalMemoryDisplay, Mode=OneWay}" Foreground="#89B4FA" FontWeight="Bold" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Anti-AFK -->
            <Border Background="#313244" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="防掛機 (Anti-AFK)" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock FontSize="11" Foreground="#6C7086" Margin="0,2,0,0">
                            <Run Text="定時向所有 Roblox 視窗發送按鍵，防止 20 分鐘被踢出" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="間隔" Foreground="#A6ADC8" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                        <TextBox Text="{Binding AntiAfkIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#45475A" Foreground="#CDD6F4" BorderBrush="#585B70"
                                 Width="40" Padding="4,3" FontSize="12" TextAlignment="Center"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Text=" 分鐘" Foreground="#A6ADC8" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>

                    <Button Grid.Column="2" Command="{Binding ToggleAntiAfkCommand}" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Content" Value="啟用" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAntiAfkEnabled}" Value="True">
                                        <Setter Property="Content" Value="停用" />
                                        <Setter Property="Background" Value="#A6E3A1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Auto Cookie Sync -->
            <Border Background="#313244" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="自動 Cookie 同步" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock FontSize="11" Foreground="#6C7086" Margin="0,2,0,0"
                                   Text="自動偵測前景 Roblox 視窗，切換對應帳號的 Cookie，讓所有實例都能跳轉地點" />
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding ToggleAutoCookieSyncCommand}" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Content" Value="啟用" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoCookieSyncEnabled}" Value="True">
                                        <Setter Property="Content" Value="停用" />
                                        <Setter Property="Background" Value="#A6E3A1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Controls -->
            <StackPanel Orientation="Horizontal">
                <Button Content="重新整理" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                <Button Content="全部停止" Command="{Binding StopAllCommand}"
                        Style="{StaticResource DangerButton}" />
            </StackPanel>
        </StackPanel>

        <!-- Status -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                   Foreground="#A6ADC8" Margin="0,8,0,0" FontSize="12" />

        <!-- Instance List -->
        <ListView ItemsSource="{Binding Instances}" Background="Transparent" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="#313244" CornerRadius="8" Padding="12" Margin="0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Account.Label}" FontSize="14"
                                           FontWeight="SemiBold" Foreground="#CDD6F4" />
                                <TextBlock FontSize="11" Foreground="#6C7086" Margin="0,2,0,0">
                                    <Run Text="PID: " />
                                    <Run Text="{Binding ProcessId, Mode=OneWay}" />
                                    <Run Text=" | Place: " />
                                    <Run Text="{Binding PlaceId, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="16,0"
                                       FontSize="12" Foreground="#A6ADC8">
                                <Run Text="CPU: " />
                                <Run Text="{Binding CpuPercent, StringFormat='{}{0:F1}%', Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="16,0"
                                       FontSize="12" Foreground="#A6ADC8">
                                <Run Text="RAM: " />
                                <Run Text="{Binding MemoryDisplay, Mode=OneWay}" />
                            </TextBlock>

                            <Border Grid.Column="3" CornerRadius="4" Padding="8,4" Margin="8,0"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#45475A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                <Setter Property="Background" Value="#1E4620" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Exited">
                                                <Setter Property="Background" Value="#4E2020" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#CDD6F4" />
                            </Border>

                            <Button Grid.Column="4" Content="啟用Teleport" Margin="8,0,0,0"
                                    Command="{Binding DataContext.ActivateTeleportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding ProcessId}"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="將此帳號的 Cookie 寫入 Roblox，讓此實例可以跳轉地點" />
                            <Button Grid.Column="5" Content="停止" Margin="8,0,0,0"
                                    Command="{Binding DataContext.StopInstanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding ProcessId}"
                                    Style="{StaticResource DangerButton}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </DockPanel>
</UserControl>
