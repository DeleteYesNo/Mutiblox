<UserControl x:Class="Mutiblox.Views.Pages.LauncherPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#CDD6F4" Padding="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,0">
            <TextBlock Text="啟動器" FontSize="24" FontWeight="Bold" Margin="0,0,0,16" />

            <!-- Account Selection (Multi-select) -->
            <Border Background="#313244" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center">
                            <Run Text="選擇帳號" />
                            <Run Text="{Binding SelectedCountDisplay, Mode=OneWay}" Foreground="#A6ADC8" FontSize="12" />
                        </TextBlock>
                        <Button Grid.Column="1" Content="全選" Margin="8,0,0,0"
                                Command="{Binding SelectAllCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" />
                        <Button Grid.Column="2" Content="取消全選" Margin="4,0,0,0"
                                Command="{Binding DeselectAllCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" />
                        <Button Grid.Column="3" Content="重新整理" Margin="4,0,0,0"
                                Command="{Binding RefreshAccountsCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Accounts}" x:Name="AccountList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#45475A" CornerRadius="4" Padding="8,6" Margin="0,2"
                                        MouseLeftButtonDown="AccountItem_Click" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,8,0"
                                                  Checked="AccountCheckBox_Changed" Unchecked="AccountCheckBox_Changed" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13"
                                                   VerticalAlignment="Center" Foreground="#CDD6F4" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Place ID -->
            <TextBlock Text="Place ID" FontSize="14" Margin="0,0,0,4" />
            <TextBox Text="{Binding PlaceId, UpdateSourceTrigger=PropertyChanged}"
                     Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"
                     Padding="8,6" Margin="0,0,0,12" />

            <!-- Launch Mode -->
            <TextBlock Text="啟動模式" FontSize="14" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding LaunchModes}" SelectedItem="{Binding SelectedLaunchMode}"
                      Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"
                      Padding="8,6" Margin="0,0,0,12" />

            <!-- Job ID (for server join) -->
            <TextBlock Text="Server Job ID (選填)" FontSize="14" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding JobId, UpdateSourceTrigger=PropertyChanged}"
                         Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"
                         Padding="8,6" />
                <Button Grid.Column="1" Content="瀏覽伺服器" Margin="8,0,0,0"
                        x:Name="BrowseServersButton" Click="BrowseServers_Click"
                        Style="{StaticResource SecondaryButton}" />
            </Grid>

            <!-- Private Server Link -->
            <Border Background="#313244" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="私人伺服器連結" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="貼上分享連結，自動解析 Place ID 和 Access Code"
                               FontSize="11" Foreground="#6C7086" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding PrivateServerLink, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#45475A" Foreground="#CDD6F4" BorderBrush="#585B70"
                                 Padding="8,6" FontSize="12" />
                        <Button Grid.Column="1" Content="解析連結" Margin="8,0,0,0"
                                Command="{Binding ResolvePrivateServerCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Graphics Preset -->
            <TextBlock Text="畫質預設" FontSize="14" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding GraphicsPresets}" SelectedItem="{Binding SelectedPreset}"
                      Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"
                      Padding="8,6" Margin="0,0,0,12" />

            <!-- FPS Limit -->
            <TextBlock Text="FPS 上限" FontSize="14" Margin="0,0,0,4" />
            <TextBox Text="{Binding FpsLimit, UpdateSourceTrigger=PropertyChanged}"
                     Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"
                     Padding="8,6" Margin="0,0,0,16" />

            <!-- Launch Button -->
            <Button Command="{Binding LaunchCommand}"
                    IsEnabled="{Binding IsLaunching, Converter={StaticResource InverseBool}}"
                    Style="{StaticResource PrimaryButton}"
                    FontSize="16" Padding="20,10" HorizontalAlignment="Stretch"
                    Margin="0,0,0,12">
                <Button.Content>
                    <TextBlock>
                        <Run Text="一鍵啟動" />
                        <Run Text="{Binding SelectedCountDisplay, Mode=OneWay}" FontSize="12" />
                    </TextBlock>
                </Button.Content>
            </Button>

            <!-- Status (selectable for copy) -->
            <TextBox Text="{Binding StatusMessage, Mode=OneWay}" Foreground="#A6ADC8" FontSize="12"
                     TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0"
                     Background="Transparent" Padding="0" Margin="0"
                     IsTabStop="False" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
