<UserControl x:Class="Mutiblox.Views.Pages.GameBrowserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Foreground="#CDD6F4">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#181825" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Account selector -->
                <TextBlock Grid.Column="0" Text="帳號:" VerticalAlignment="Center"
                           Foreground="#A6ADC8" Margin="0,0,6,0" FontSize="12" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Accounts}"
                          SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="Label"
                          Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"
                          Padding="6,4" Width="180" FontSize="12"
                          SelectionChanged="Account_SelectionChanged" />

                <!-- URL bar (read-only, shows current page) -->
                <TextBox Grid.Column="2" x:Name="UrlBar" IsReadOnly="True"
                         Background="#313244" Foreground="#6C7086" BorderBrush="#45475A"
                         Padding="6,4" Margin="8,0" FontSize="11"
                         VerticalContentAlignment="Center" />

                <!-- Navigation buttons -->
                <Button Grid.Column="3" Content="&#x2190;" Click="Back_Click"
                        Background="#45475A" Foreground="#CDD6F4" Padding="8,4"
                        BorderThickness="0" Cursor="Hand" FontSize="14" Margin="0,0,4,0" />
                <Button Grid.Column="4" Content="&#x21BB;" Click="Refresh_Click"
                        Background="#45475A" Foreground="#CDD6F4" Padding="8,4"
                        BorderThickness="0" Cursor="Hand" FontSize="14" Margin="0,0,4,0" />
                <Button Grid.Column="5" Content="&#x2302;" Click="Home_Click"
                        Background="#45475A" Foreground="#CDD6F4" Padding="8,4"
                        BorderThickness="0" Cursor="Hand" FontSize="14" />
            </Grid>
        </Border>

        <!-- WebView2 Browser -->
        <wv2:WebView2 x:Name="GameWebView" Grid.Row="1" />

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#181825" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#A6ADC8"
                           FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="畫質:" Foreground="#6C7086" FontSize="11" VerticalAlignment="Center"
                               Margin="0,0,4,0" />
                    <ComboBox ItemsSource="{Binding GraphicsPresets}" SelectedItem="{Binding SelectedPreset}"
                              Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"
                              Padding="4,2" FontSize="11" Width="80" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="FPS:" Foreground="#6C7086" FontSize="11" VerticalAlignment="Center"
                               Margin="0,0,4,0" />
                    <TextBox Text="{Binding FpsLimit, UpdateSourceTrigger=PropertyChanged}"
                             Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"
                             Padding="4,2" Width="40" FontSize="11" TextAlignment="Center"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <ProgressBar Grid.Column="3" IsIndeterminate="{Binding IsLaunching}"
                             Visibility="{Binding IsLaunching, Converter={StaticResource BoolToVisibility}}"
                             Width="80" Height="3" Background="Transparent" Foreground="#89B4FA"
                             Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
