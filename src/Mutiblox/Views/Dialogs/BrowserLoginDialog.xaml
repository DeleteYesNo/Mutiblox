<Window x:Class="Mutiblox.Views.Dialogs.BrowserLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="登入 Roblox 帳號" Height="720" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#181825" Padding="16,10">
            <StackPanel>
                <TextBlock Text="登入你的 Roblox 帳號" FontSize="16" FontWeight="SemiBold"
                           Foreground="#CDD6F4" />
                <TextBlock Text="登入完成後將自動擷取 Cookie" FontSize="12"
                           Foreground="#A6ADC8" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- WebView2 -->
        <wv2:WebView2 x:Name="LoginWebView" Grid.Row="1" />

        <!-- Footer -->
        <Border Grid.Row="2" Background="#181825" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0"
                           Text="等待登入..." Foreground="#A6ADC8"
                           VerticalAlignment="Center" FontSize="12" />

                <Button x:Name="RetryButton" Grid.Column="1" Content="重新載入"
                        Click="RetryButton_Click" Margin="0,0,8,0"
                        Background="#45475A" Foreground="#CDD6F4" Padding="14,7"
                        BorderThickness="0" Cursor="Hand" />

                <Button x:Name="CancelButton" Grid.Column="2" Content="取消"
                        Click="CancelButton_Click"
                        Background="#F38BA8" Foreground="#1E1E2E" Padding="14,7"
                        BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" />
            </Grid>
        </Border>
    </Grid>
</Window>
