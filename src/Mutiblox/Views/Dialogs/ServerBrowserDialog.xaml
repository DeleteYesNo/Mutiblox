<Window x:Class="Mutiblox.Views.Dialogs.ServerBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="瀏覽伺服器" Height="520" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E" Foreground="#CDD6F4">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header + Search -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="選擇伺服器" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilterBox" Grid.Column="0"
                         Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"
                         Padding="8,6" FontSize="13" VerticalContentAlignment="Center"
                         TextChanged="FilterBox_TextChanged" />
                <TextBlock Grid.Column="0" Text="搜尋 Job ID..." IsHitTestVisible="False"
                           Foreground="#6C7086" Padding="10,7" FontSize="13"
                           Visibility="{Binding Text.Length, ElementName=FilterBox, Converter={StaticResource InverseLengthToVisibility}}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <TextBlock VerticalAlignment="Center" Foreground="#A6ADC8" FontSize="12"
                               Margin="0,0,8,0" x:Name="CountText" />
                    <Button Content="重新整理" Click="Refresh_Click"
                            Background="#45475A" Foreground="#CDD6F4" Padding="14,7"
                            BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Server List -->
        <ListView x:Name="ServerList" Grid.Row="1"
                  Background="Transparent" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  MouseDoubleClick="ServerList_MouseDoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="#313244" CornerRadius="6" Padding="12,10" Margin="0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Player count badge -->
                            <Border Grid.Column="0" CornerRadius="4" Padding="8,4" Margin="0,0,12,0"
                                    VerticalAlignment="Center" MinWidth="60" HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#313244" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFull}" Value="True">
                                                <Setter Property="Background" Value="#4E2020" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFull}" Value="False">
                                                <Setter Property="Background" Value="#1E4620" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding PlayerDisplay}" FontSize="13"
                                           FontWeight="SemiBold" Foreground="#CDD6F4"
                                           HorizontalAlignment="Center" />
                            </Border>

                            <!-- Job ID -->
                            <TextBlock Grid.Column="1" Text="{Binding JobId}" FontSize="12"
                                       Foreground="#A6ADC8" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- Ping / FPS -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="8,0,0,0">
                                <TextBlock FontSize="11" Foreground="#6C7086" Margin="0,0,8,0">
                                    <Run Text="Ping " />
                                    <Run Text="{Binding Ping, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="#6C7086">
                                    <Run Text="FPS " />
                                    <Run Text="{Binding Fps, StringFormat='{}{0:F0}', Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#6C7086"
                       FontSize="12" VerticalAlignment="Center" />

            <Button Grid.Column="1" Content="選擇" Click="Select_Click" Margin="0,0,8,0"
                    Background="#89B4FA" Foreground="#1E1E2E" Padding="20,8"
                    BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" />

            <Button Grid.Column="2" Content="取消" Click="Cancel_Click"
                    Background="#45475A" Foreground="#CDD6F4" Padding="20,8"
                    BorderThickness="0" Cursor="Hand" />
        </Grid>
    </Grid>

    <Window.Resources>
        <!-- Helper converter: show placeholder when text is empty -->
        <BooleanToVisibilityConverter x:Key="InverseLengthToVisibility" />
    </Window.Resources>
</Window>
